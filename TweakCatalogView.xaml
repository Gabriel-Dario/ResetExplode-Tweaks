<UserControl x:Class="ResetExplode.TweakCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource Fg}">
    <UserControl.Resources>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Background" Value="{DynamicResource Card}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Foreground="{DynamicResource Fg}" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False">
                                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="6"><Grid Margin="10,7"><TextBlock Text="⌄" HorizontalAlignment="Right" Foreground="{DynamicResource Fg}"/><ContentPresenter Margin="0,0,20,0"/></Grid></Border></ControlTemplate></ToggleButton.Template>
                                <ContentPresenter TextElement.Foreground="{DynamicResource Fg}" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                                <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="300"><ItemsPresenter/></ScrollViewer></Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource Fg}"/><Setter Property="Padding" Value="10,8"/><Setter Property="Background" Value="{DynamicResource Card}"/></Style>
    </UserControl.Resources>
    <Grid Margin="30,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="TWEAKS DO WINDOWS" Style="{StaticResource H1}"/>
            <TextBlock Text="Ajustes executáveis · estado anterior salvo · restauração por item" Style="{StaticResource Sub}"/>
            <TextBlock x:Name="CatalogSummary" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Tag="Buscar tweaks por nome, categoria ou efeito…" TextChanged="Filter_Changed" ToolTip="Buscar por nome, categoria ou efeito" MinHeight="32" VerticalContentAlignment="Center" Padding="8" Margin="0,0,12,0"/>
                    <ComboBox x:Name="CategoryBox" Grid.Column="1" SelectionChanged="Filter_Changed" MinHeight="32" VerticalContentAlignment="Center"/>
                </Grid>
                <WrapPanel Margin="0,12,0,0">
                    <TextBlock Text="Perfil:" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="ProfileBox" Width="140" SelectedIndex="0" VerticalContentAlignment="Center" Margin="0,0,12,6">
                        <ComboBoxItem Content="Jogos"/><ComboBoxItem Content="Produtividade"/><ComboBoxItem Content="Equilíbrio"/>
                    </ComboBox>
                    <Button x:Name="SuggestButton" Content="SELECIONAR SUGERIDOS" Style="{StaticResource OutlineButton}" Click="Suggest_Click" Padding="12,7" Margin="0,0,8,6"/>
                    <Button x:Name="ApplySelectedButton" Content="REVISAR E APLICAR SELEÇÃO" Style="{StaticResource PrimaryButton}" Click="ApplySelected_Click" Padding="12,7" Margin="0,0,8,6"/>
                    <Button x:Name="RestoreSavedButton" Content="RESTAURAR ALTERADOS" Style="{StaticResource OutlineButton}" Click="RestoreSaved_Click" Padding="12,7" Margin="0,0,8,6"/>
                    <Button x:Name="RefreshButton" Content="ATUALIZAR" Style="{StaticResource OutlineButton}" Click="Refresh_Click" Padding="12,7" Margin="0,0,0,6"/>
                </WrapPanel>
                <TextBlock Text="Sugestões apenas selecionam itens. Revise o efeito antes de aplicar. Energia avançada exige teste comparável; BIOS/OC ficam em RESET OC." Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="2" x:Name="OperationText" Text="Busque um ajuste ou escolha uma categoria. Nenhuma mudança é aplicada ao abrir esta página." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="CatalogItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="165"/></Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding Available}" VerticalAlignment="Top" Margin="0,4,12,0" ToolTip="Selecionar para aplicação em lote"/>
                                <StackPanel Grid.Column="1" Margin="0,0,18,0">
                                    <TextBlock Text="{Binding Tweak.Category}" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding Tweak.Title}" Foreground="{DynamicResource Fg}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Tweak.Description}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding Tweak.Effect}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding StateText}" Foreground="{DynamicResource Fg}" TextWrapping="Wrap" FontSize="11" Margin="0,7,0,0"/>
                                    <TextBlock Text="{Binding Tweak.Status}" Foreground="{DynamicResource Fg}" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Button Content="APLICAR AJUSTE" IsEnabled="{Binding Available}" Tag="{Binding}" Click="ApplyOne_Click" Style="{StaticResource PrimaryButton}" Padding="10,8" Margin="0,0,0,8"/>
                                    <Button Content="RESTAURAR ORIGINAL" IsEnabled="{Binding HasBackup}" Tag="{Binding}" Click="RestoreOne_Click" Style="{StaticResource OutlineButton}" Padding="10,7" FontSize="10" Margin="0,0,0,8"/>
                                    <Button Content="FONTE / DOCUMENTAÇÃO" Tag="{Binding}" Click="Source_Click" Style="{StaticResource OutlineButton}" Padding="8,7" FontSize="9"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
